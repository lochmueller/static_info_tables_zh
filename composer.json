{
	"name": "renolit/static-info-tables-zh",
	"description": "Chinese (zh) language pack for the Static Info Tables providing localized names for countries and territories.",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"keywords": [
		"TYPO3 CMS",
		"Static Info Tables",
		"Chinese"
	],
	"authors": [
		{
			"name": "Tim Lochmüller",
			"email": "webmaster@fruit-lab.de",
			"homepage": "https://github.com/lochmueller",
			"role": "Developer"
		},
		{
			"name": "Ephraim Härer",
			"email": "ephraim.haerer@renolit.com",
			"role": "Developer"
		},
		{
			"name": "Timo Feuerstein",
			"role": "Developer"
		}
	],
	"homepage": "https://github.com/Kephson/static-info-tables-hu",
	"support": {
		"email": "ephraim.haerer@renolit.com",
		"issues": "https://github.com/Kephson/static-info-tables-hu/issues",
		"source": "https://github.com/Kephson/static-info-tables-hu"
	},
	"require": {
		"php": "^8.2",
		"sjbr/static-info-tables": "^14.3",
		"typo3/cms-core": "^14.3",
		"typo3/cms-extbase": "^14.3"
	},
	"require-dev": {
		"ergebnis/composer-normalize": "^2.52"
	},
	"replace": {
		"lochmueller/static-info-tables-zh": "self.version",
		"typo3-ter/static-info-tables-zh": "self.version"
	},
	"autoload": {
		"psr-4": {
			"RENOLIT\\StaticInfoTablesZh\\": "Classes/"
		}
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"bin-dir": ".Build/bin",
		"sort-packages": true,
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/cms": {
			"Package": {
				"providesPackages": {}
			},
			"cms-package-dir": "{$vendor-dir}/typo3/cms",
			"extension-key": "static_info_tables_zh",
			"version": "14.3.1",
			"web-dir": ".Build/public"
		}
	},
	"scripts": {
		"prepare-release": [
			"@extension-create-libs",
			"rm -rf .devbox",
			"rm -rf Tests/",
			"rm .gitignore",
			"rm .scrutinizer.yml",
			"rm disabled.travis.yml",
			"rm -rf .ddev",
			"rm -rf .github",
			"rm -rf .editorconfig",
			"rm -rf .gitattributes"
		]
	}
}
